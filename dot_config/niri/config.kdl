// ════════════════════════════════════════════════════════════════════
// niri — scrollable-tiling Wayland compositor
// 由 chezmoi 托管。本配置参考 ~/.config/hypr/ 的 Hyprland 配置移植。
//
// 文档   : https://niri-wm.github.io/niri/Configuration:-Introduction
// 校验   : niri validate
// 热重载 : niri msg action 后，改动保存后 niri 会自动重载配置
// 快捷键 : niri 的 "Mod" 在 TTY 会话下等于 Super
//
// 本文件仅保留全局选项与 include 入口；其余配置按模块拆分到 core/ 下，
// 与 Hyprland 的 core/ 模块一一对应。
// 注意：include 是「位置相关」的，靠后加载的会覆盖靠前的同名设置，
//       详见 https://niri-wm.github.io/niri/Configuration:-Include
// ════════════════════════════════════════════════════════════════════

// ────────────────────────────────────────────────────────────────────
// 全局选项
// ────────────────────────────────────────────────────────────────────
// 去掉 CSD 后，niri 会把边框画在窗口 *外围* 而非背后的实心矩形，
// 半透明窗口不会再透出边框颜色（见官方 FAQ）。
// 副作用：边缘悬停 resize 手柄消失，改用 Mod+右键拖拽调整大小。
prefer-no-csd

// 启动时不再弹出 niri 的“重要快捷键”浮层（快捷键可用 Mod+Shift+Slash 查看）
hotkey-overlay {
    skip-at-startup
}

// ────────────────────────────────────────────────────────────────────
// 模块加载
// 顺序即生效顺序（位置相关）：
// ────────────────────────────────────────────────────────────────────
include "core/inputs.kdl"       // 输入设备   ← core/inputs.lua
include "core/monitors.kdl"     // 显示器     ← core/monitors.lua
include "core/layout.kdl"       // 布局与外观 ← core/decorations.lua, colors.lua
include "core/windowrules.kdl"  // 窗口/图层规则 ← core/windowrules.lua
include "core/environment.kdl"  // 环境变量   ← core/environment.lua
include "core/autostart.kdl"    // 自启动     ← shells/*/autostart.lua
include "core/binds.kdl"        // 快捷键     ← keymap.lua
