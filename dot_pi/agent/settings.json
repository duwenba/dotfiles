{
  "compaction": {
    "enabled": false
  },
  "defaultModel": "ark-code-latest",
  "defaultProvider": "agent-plan",
  "defaultThinkingLevel": "low",
  "extensions": [
    "-extensions/cny-footer.ts"
  ],
  "hideThinkingBlock": true,
  "images": {
    "blockImages": false
  },
  "lastChangelogVersion": "0.85.1",
  "packages": [
    {
      "extensions": [
        "-index.ts"
      ],
      "source": "npm:pi-deepseek-search"
    },
    {
      "extensions": [
        "-index.ts"
      ],
      "source": "npm:pi-spark",
      "themes": [
        "-themes/github-dark-default.json",
        "-themes/github-light-default.json"
      ]
    },
    {
      "extensions": [
        "-src/index.ts"
      ],
      "source": "npm:@zigai/pi-ui-tweaks"
    },
    {
      "extensions": [
        "+index.ts"
      ],
      "source": "npm:@juicesharp/rpiv-ask-user-question"
    }
  ],
