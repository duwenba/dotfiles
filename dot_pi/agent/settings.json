    "-skills/arkcli-config/SKILL.md",
    "-skills/arkcli-connect/SKILL.md",
    "-skills/arkcli-deploy/SKILL.md",
    "-skills/arkcli-gen/SKILL.md",
    "-skills/arkcli-infer-endpoint/SKILL.md",
    "-skills/arkcli-onboard/SKILL.md",
    "-skills/arkcli-understand/SKILL.md",
    "-skills/arkcli-usage/SKILL.md",
    "+skills/byted-web-search/SKILL.md",
    "-skills/arkcli-helper/SKILL.md",
    "-skills/arkcli-train-finetune/SKILL.md",
    "-skills/arkcli-api-explorer/SKILL.md",
    "-skills/arkcli-custommodel/SKILL.md",
    "-skills/arkcli-doctor/SKILL.md",
    "-skills/arkcli-models/SKILL.md",
    "-skills/arkcli-plans/SKILL.md",
